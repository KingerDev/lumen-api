# ---------------------------------------------------------------------------
# Lumen API — Laravel (nasadené cez Coolify)
#
# TU patria skutočné R2 kľúče.
#
#   Lokálny vývoj:  skopíruj do server/.env  (je v .gitignore)
#   Coolify:        Project → Application → Environment Variables
#                   Coolify ich drží zašifrované a injektuje pri behu.
#                   Do gitu sa nikdy nedostanú.
#
# Mobilná appka nič z tohto nevidí — dostane len URL tohto API.
# ---------------------------------------------------------------------------

APP_NAME=Lumen
APP_ENV=production
APP_DEBUG=false
APP_URL=https://lumen-api.tvoja-domena.sk

# php artisan key:generate --show   (v Coolify nastav ako env premennú)
APP_KEY=

# --- Databáza -------------------------------------------------------------
# V Coolify pridaj Postgres ako resource v tom istom projekte; DB_HOST je
# potom názov tej služby vo vnútornej sieti, nie localhost.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lumen
DB_USERNAME=lumen
DB_PASSWORD=

# --- Cloudflare R2 --------------------------------------------------------
# R2 je S3-kompatibilné, takže sa používa štandardný Laravel S3 driver.
# Token: Cloudflare → R2 → Manage R2 API Tokens → Create API Token
#        Práva: Object Read & Write, obmedzené na jeden bucket.
FILESYSTEM_DISK=r2

# Zámerne R2_* a nie AWS_* — stock Laravel .env má AWS_DEFAULT_REGION=us-east-1
# a AWS_USE_PATH_STYLE_ENDPOINT=false, čo by ticho prebilo hodnoty pre R2
# a rozbilo každú podpísanú URL.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lumen-media

# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Ako dlho platia podpísané URL (sekundy)
R2_UPLOAD_URL_TTL=900
R2_DOWNLOAD_URL_TTL=3600
